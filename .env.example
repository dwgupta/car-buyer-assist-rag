# =============================================================================
# Car Buyer Assist RAG Application - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to version control (it's in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# GCP Vertex AI (Primary - used by RAG application for embeddings & LLM)
# -----------------------------------------------------------------------------
# Required for document processing, embeddings (text-embedding-004), and
# response generation (gemini-1.5-pro) via Vertex AI.
GOOGLE_PROJECT_ID=your-gcp-project-id
GOOGLE_REGION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account-key.json

# -----------------------------------------------------------------------------
# LangSmith (Observability & Tracing)
# -----------------------------------------------------------------------------
# Required for tracking prompts, responses, token usage, latency, and costs.
# Get your API key from https://smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=car-buyer-assist-rag

# Optional: Set to "true" to enable LangSmith tracing (default is usually enabled when API key is set)
# LANGSMITH_TRACING=true

# -----------------------------------------------------------------------------
# Gemini API (Alternative - used by gemini_api_key_test.py only)
# -----------------------------------------------------------------------------
# Only needed if using the Gemini Developer API directly (e.g., for testing).
# The main RAG app uses Vertex AI above, not this API key.
# GOOGLE_API_KEY=your-gemini-api-key
